  "sidebarHtml": "<div class=\"w-64 bg-evernote-sidebar text-white flex flex-col h-full\"><div class=\"p-4 border-b border-gray-700\"><div class=\"flex items-center justify-between mb-1\"><span class=\"font-semibold cursor-pointer hover:text-evernote-green truncate\">Tung</span><button class=\"text-sm text-gray-400 hover:text-white flex-shrink-0 ml-2\">Logout</button></div><div class=\"flex items-center gap-2 mb-3\"><span class=\"text-xs text-gray-400 truncate\">Tung's Workspace</span><span class=\"text-xs px-1.5 py-0.5 rounded flex-shrink-0 bg-gray-600 text-gray-300\">FREE</span></div><button class=\"w-full bg-evernote-green text-white py-2 rounded hover:bg-green-600 transition\">+ New Note</button></div><nav class=\"flex-1 overflow-y-auto\"><div class=\"px-4 py-2 cursor-pointer hover:bg-evernote-hover bg-evernote-hover text-evernote-green\">📝 All Notes</div><div class=\"px-4 py-2 cursor-pointer hover:bg-evernote-hover text-gray-300\">👥 Shared with me</div><div class=\"px-4 py-2 cursor-pointer hover:bg-evernote-hover text-gray-300\">🗑️ Trash</div><div class=\"mt-4\"><div class=\"px-4 py-2 text-gray-400 text-sm flex justify-between cursor-pointer\"><span>NOTEBOOKS</span><span>▼</span></div><div class=\"px-4 py-2 flex gap-2\"><input placeholder=\"New notebook\" class=\"flex-1 bg-evernote-dark text-white px-2 py-1 rounded text-sm\" value=\"\"><button class=\"text-evernote-green\">+</button></div></div><div class=\"mt-4\"><div class=\"px-4 py-2 text-gray-400 text-sm flex justify-between cursor-pointer\"><span>TAGS</span><span>▼</span></div><div class=\"px-4 py-2 flex gap-2\"><input placeholder=\"New tag\" class=\"flex-1 bg-evernote-dark text-white px-2 py-1 rounded text-sm\" value=\"\"><button class=\"text-evernote-green\">+</button></div></div><div class=\"mt-4 px-4\"><input type=\"file\" accept=\".enex\" class=\"hidden\"><button class=\"w-full text-left px-4 py-2 text-gray-300 hover:bg-evernote-hover rounded text-sm\">📥 Import from Evernote</button></div></nav></div>